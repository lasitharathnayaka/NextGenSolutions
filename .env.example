# Firebase Configuration (from Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Admin WhatsApp Number for Order Redirect (digits only with country code, e.g. 94771234567)
VITE_ADMIN_WHATSAPP=94770000000

# Cloudinary Free Tier Image Uploads (Settings -> Upload -> Unsigned Upload Preset)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
